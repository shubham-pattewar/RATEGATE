# --- Server ---
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# --- MongoDB (users, endpoints, request logs) ---
MONGODB_URI=mongodb://localhost:27017/rategate

# --- Redis (rate-limit counters) ---
# Leave unset to run with the in-memory fallback store (NOT for production).
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-me-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=7d

# --- Dashboard origin allowed by CORS (comma-separated for several) ---
CORS_ORIGIN=http://localhost:5173

# --- Proxy ---
PROXY_TIMEOUT_MS=15000
# Allow registering targets on localhost / private networks (handy for local demos, unsafe in prod).
ALLOW_PRIVATE_TARGETS=false

# --- Request log retention (MongoDB TTL index) ---
LOG_RETENTION_DAYS=7
